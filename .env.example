# Authentication. Never commit real keys.
ENABLE_AUTH=false
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Live news is optional. Copy the names you need into .env.
ENABLE_LIVE_NEWS=false
NEWS_API_KEY=
NEWS_DEFAULT_QUERY=Nigeria
NEWS_RESULT_LIMIT=5
NEWS_API_TIMEOUT_SECONDS=8
